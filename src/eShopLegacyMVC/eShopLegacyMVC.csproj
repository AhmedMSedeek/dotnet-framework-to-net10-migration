<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShopLegacyMVC</RootNamespace>
    <!-- Kept off on purpose: with nullable enabled, ASP.NET Core treats non-nullable string
         properties as [Required], which would silently make CatalogItem.Description mandatory. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\eShopLegacy.Utilities\eShopLegacy.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed files read at startup when UseCustomizationData = true -->
    <Content Update="Setup\**" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Setup\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
