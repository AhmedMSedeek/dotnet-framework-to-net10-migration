@model IEnumerable<eShopLegacyMVC.Models.CatalogItem>
@* Performance: Html.DisplayFor(modelItem => item.X) inside a loop captures 'item' in a closure, which ASP.NET Core
   compiles on every call (MVC 5 cached it). 100 cells cost ~28 ms per page; plain Razor output renders the same HTML. *@

<table class="table">
    <thead>
        <tr class="esh-table-header">
            <th>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CatalogBrand.Brand)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CatalogType.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PictureFileName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AvailableStock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RestockThreshold)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxStockThreshold)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
            {
            <tr>
                <td>
                    <img class="esh-thumbnail" src="@item.PictureUri" />
                </td>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.CatalogBrand.Brand
                </td>
                <td>
                    @item.CatalogType.Type
                </td>
                <td class="esh-table-price">
                    @item.Price.ToString("C") @* same output as DisplayFor + [DataType(Currency)] *@
                </td>
                <td>
                    @item.PictureFileName
                </td>
                <td>
                    @item.AvailableStock
                </td>
                <td>
                    @item.RestockThreshold
                </td>
                <td>
                    @item.MaxStockThreshold
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "esh-table-link" }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "esh-table-link" }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "esh-table-link" })
                </td>
            </tr>
        }
    </tbody>

</table>